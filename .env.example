# MailGuard1 Configuration

APP_NAME=MailGuard
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# SQLite Database Location
DATABASE_URL=sqlite:///./mailguard.db

# Default Security Sensitivity Threshold (0.3 to 0.9)
DEFAULT_THRESHOLD=0.5

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback

# Session Security & Token Encryption
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
SESSION_COOKIE_NAME=mailguard_session
TOKEN_ENCRYPTION_KEY=
